# ===== 真·微信登录（个人主体小程序）=====
# 微信公众平台 → 小程序 → 开发管理 → 开发设置，复制 AppID / AppSecret
WX_MINI_APPID=
WX_MINI_APPSECRET=
# 小程序码打开哪个版本：develop=开发版（本机调试） / trial=体验版 / release=正式版
WX_MINI_ENV=develop
# 扫码落到哪个页面（必须真实存在）
WX_MINI_PAGE=pages/login/login

# ===== GitHub OAuth（可选）=====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 可选；默认使用 http://<当前 host>/api/auth/github/callback
GITHUB_CALLBACK_URL=
