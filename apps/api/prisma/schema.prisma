// Prisma schema — structural source of truth for tables.
// Hot paths (claim worker, automation find) use raw SQL and never go through Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships WorkspaceMember[]
  comments    Comment[]
  notifications Notification[]

  @@map("users")
}

enum WorkspaceRole {
  owner
  admin
  editor
  viewer
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members WorkspaceMember[]
  bases   Base[]
  folders Folder[]
  sharesOut CrossWorkspaceShare[] @relation("ShareSourceWorkspace")
  sharesIn  CrossWorkspaceShare[] @relation("ShareTargetWorkspace")

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(editor)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Base {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sheets Sheet[]
  forms  Form[]
  automations Automation[]
  dashboards Dashboard[]
  folderId String? @map("folder_id") @db.Uuid
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([folderId])
  @@map("bases")
}

model Folder {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderChildren")
  bases     Base[]

  @@index([workspaceId])
  @@index([parentId])
  @@map("folders")
}

model Sheet {
  id        String   @id @default(uuid()) @db.Uuid
  baseId    String   @map("base_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  base    Base        @relation(fields: [baseId], references: [id], onDelete: Cascade)
  fields  Field[]
  records RecordRow[]
  comments Comment[]
  forms   Form[]

  @@index([baseId])
  @@map("sheets")
}

model Field {
  id        String   @id @default(uuid()) @db.Uuid
  sheetId   String   @map("sheet_id") @db.Uuid
  name      String
  type      String
  options   Json?
  order     Int      @default(0)
  required  Boolean  @default(false)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId])
  @@map("fields")
}

// Table name is "records"; the Prisma model avoids shadowing TS's Record utility.
model RecordRow {
  id          String   @id @default(uuid(7)) @db.Uuid
  sheetId     String   @map("sheet_id") @db.Uuid
  cells       Json     @default("{}")
  version     Int      @default(1)
  // Indexable side column for claim hot paths (never the only representation).
  claimStatus String?  @map("claim_status")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId, id])
  @@index([sheetId, claimStatus])
  @@map("records")
}

model Comment {
  id        String   @id @default(uuid(7)) @db.Uuid
  sheetId   String   @map("sheet_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sheet  Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([sheetId, createdAt])
  @@map("comments")
}

model Form {
  id              String   @id @default(uuid()) @db.Uuid
  baseId          String   @map("base_id") @db.Uuid
  sheetId         String   @map("sheet_id") @db.Uuid
  name            String
  coverUrl        String?  @map("cover_url")
  fields          Json     @default("[]")
  share           Json     @default("{}")
  shareToken      String   @unique @map("share_token")
  successTemplate String   @default("") @map("success_template")
  rejectDuplicatePhone Boolean @default(true) @map("reject_duplicate_phone")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  base        Base             @relation(fields: [baseId], references: [id], onDelete: Cascade)
  sheet       Sheet            @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@index([baseId])
  @@index([sheetId])
  @@map("forms")
}

model FormSubmission {
  id        String   @id @default(uuid(7)) @db.Uuid
  formId    String   @map("form_id") @db.Uuid
  recordId  String?  @map("record_id") @db.Uuid
  status    String   @default("completed")
  cells     Json     @default("{}")
  resultHtml String? @map("result_html")
  stepOutputs Json  @default("{}") @map("step_outputs")
  error     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@map("form_submissions")
}

model Automation {
  id           String   @id @default(uuid()) @db.Uuid
  baseId       String   @map("base_id") @db.Uuid
  name         String
  enabled      Boolean  @default(true)
  trigger      Json
  steps        Json     @default("[]")
  onFindEmpty  String   @default("continue") @map("on_find_empty")
  monthlyQuota Int?     @map("monthly_quota")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  base Base            @relation(fields: [baseId], references: [id], onDelete: Cascade)
  runs AutomationRun[]

  @@index([baseId])
  @@map("automations")
}

model AutomationRun {
  id              String    @id @default(uuid(7)) @db.Uuid
  automationId    String    @map("automation_id") @db.Uuid
  status          String    @default("running")
  idempotencyKey  String?   @map("idempotency_key")
  triggerRecordId String?   @map("trigger_record_id") @db.Uuid
  outputs         Json      @default("{}")
  error           String?
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs      Int?      @map("duration_ms")

  automation Automation        @relation(fields: [automationId], references: [id], onDelete: Cascade)
  steps      AutomationRunStep[]

  @@unique([automationId, idempotencyKey])
  @@index([automationId, startedAt])
  @@map("automation_runs")
}

model AutomationRunStep {
  id         String   @id @default(uuid(7)) @db.Uuid
  runId      String   @map("run_id") @db.Uuid
  stepIndex  Int      @map("step_index")
  type       String
  status     String
  output     Json     @default("{}")
  error      String?
  durationMs Int?     @map("duration_ms")

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, stepIndex])
  @@map("automation_run_steps")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model GroupChat {
  id        String   @id @default(uuid(7)) @db.Uuid
  baseId    String   @map("base_id") @db.Uuid
  name      String
  memberIds Json     @default("[]") @map("member_ids")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([baseId])
  @@map("group_chats")
}

model ContentPermission {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  objectType  String   @map("object_type")
  objectId    String   @map("object_id") @db.Uuid
  /// everyone | member
  subjectType String   @map("subject_type") @default("everyone")
  /// empty string for the everyone row; user id for member rows
  subjectId   String   @map("subject_id") @default("")
  /// full | edit | view | none
  level       String
  recordRule  Json?    @map("record_rule")
  fieldRule   Json?    @map("field_rule")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([objectType, objectId, subjectType, subjectId])
  @@index([workspaceId, objectType])
  @@map("content_permissions")
}

model Dashboard {
  id        String   @id @default(uuid()) @db.Uuid
  baseId    String   @map("base_id") @db.Uuid
  name      String
  /// dashboard | report
  kind      String   @default("dashboard")
  layout    Json     @default("[]")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  base      Base             @relation(fields: [baseId], references: [id], onDelete: Cascade)
  widgets   DashboardWidget[]
  schedules DashboardSchedule[]

  @@index([baseId])
  @@map("dashboards")
}

model DashboardWidget {
  id          String   @id @default(uuid()) @db.Uuid
  dashboardId String   @map("dashboard_id") @db.Uuid
  /// bar | line | pie | metric | table
  type        String
  title       String
  sheetId     String?  @map("sheet_id") @db.Uuid
  /// { dimensionFieldId, metricFieldId, aggregation, filters? }
  config      Json     @default("{}")
  layout      Json     @default("{}")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@map("dashboard_widgets")
}

model DashboardSchedule {
  id          String    @id @default(uuid()) @db.Uuid
  dashboardId String    @map("dashboard_id") @db.Uuid
  cron        String
  /// notification | group-chat | wecom
  channel     String    @default("notification")
  enabled     Boolean   @default(true)
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz(6)
  nextRunAt   DateTime? @map("next_run_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  dashboard Dashboard            @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  runs      DashboardScheduleRun[]

  @@index([dashboardId])
  @@map("dashboard_schedules")
}

model DashboardScheduleRun {
  id         String   @id @default(uuid()) @db.Uuid
  scheduleId String   @map("schedule_id") @db.Uuid
  status     String
  message    String   @default("")
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  schedule DashboardSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, createdAt])
  @@map("dashboard_schedule_runs")
}

model CrossWorkspaceShare {
  id                String   @id @default(uuid()) @db.Uuid
  sourceWorkspaceId String   @map("source_workspace_id") @db.Uuid
  targetWorkspaceId String   @map("target_workspace_id") @db.Uuid
  /// base | sheet
  objectType        String   @map("object_type")
  objectId          String   @map("object_id") @db.Uuid
  /// view | edit
  role              String
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sourceWorkspace Workspace @relation("ShareSourceWorkspace", fields: [sourceWorkspaceId], references: [id], onDelete: Cascade)
  targetWorkspace Workspace @relation("ShareTargetWorkspace", fields: [targetWorkspaceId], references: [id], onDelete: Cascade)

  @@unique([objectType, objectId, targetWorkspaceId])
  @@index([targetWorkspaceId])
  @@index([sourceWorkspaceId])
  @@map("cross_workspace_shares")
}
