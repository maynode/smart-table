// Prisma schema — structural source of truth for tables.
// Hot paths (claim worker, automation find) use raw SQL and never go through Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid()) @db.Uuid
  /// 登录账号（小写存储，不区分大小写）
  account             String   @unique
  passwordHash        String   @map("password_hash")
  name                String
  /// 3D 卡通头像种子（DiceBear adventurer）
  avatarSeed          String   @default("") @map("avatar_seed")
  /// 自定义上传头像 URL（方图；有值时优先于种子）
  avatarUrl           String?  @map("avatar_url")
  /// 密保问题（明文）
  securityQuestion    String   @map("security_question")
  /// 密保答案哈希（答案规范化后 argon2）
  securityAnswerHash  String   @map("security_answer_hash")
  wecomUserId         String?  @unique @map("wecom_user_id")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships WorkspaceMember[]
  comments    Comment[]
  notifications Notification[]

  @@map("users")
}

enum WorkspaceRole {
  owner
  admin
  editor
  viewer
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members WorkspaceMember[]
  invites WorkspaceInvite[]
  bases   Base[]
  sharesOut CrossWorkspaceShare[] @relation("ShareSourceWorkspace")
  sharesIn  CrossWorkspaceShare[] @relation("ShareTargetWorkspace")
  apiKeys   ApiKey[]
  webhooks  Webhook[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(editor)
  /// 成员个人置顶时间；非空则在「我的工作区」列表置顶
  pinnedAt    DateTime?     @map("pinned_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([userId, pinnedAt])
  @@map("workspace_members")
}

/// 邀请尚未注册的账号；对方注册后自动转为 WorkspaceMember
model WorkspaceInvite {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  /// 被邀请账号（小写）
  account     String
  role        WorkspaceRole @default(editor)
  invitedById String?       @map("invited_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, account])
  @@index([account])
  @@map("workspace_invites")
}

model Base {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sheets Sheet[]
  forms  Form[]
  automations Automation[]
  dashboards Dashboard[]
  analysisReports AnalysisReport[]

  @@index([workspaceId, sortOrder])
  @@map("bases")
}

model Sheet {
  id        String   @id @default(uuid()) @db.Uuid
  baseId    String   @map("base_id") @db.Uuid
  name      String
  /** Pad-level revision (WeCom base_rev / new_rev). */
  sheetRev  Int      @default(0) @map("sheet_rev")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  base    Base        @relation(fields: [baseId], references: [id], onDelete: Cascade)
  fields  Field[]
  records RecordRow[]
  comments Comment[]
  forms   Form[]
  publicViews PublicView[]
  dataSyncs DataSync[]
  savedViews SavedView[]
  changesets SheetChangeset[]

  @@index([baseId])
  @@map("sheets")
}

/** Append-only changeset log for realtime collab (ACCEPT_COMMIT / NEW_CHANGES). */
model SheetChangeset {
  id        String   @id @default(uuid(7)) @db.Uuid
  sheetId   String   @map("sheet_id") @db.Uuid
  rev       Int
  authorId  String?  @map("author_id") @db.Uuid
  commitId  String   @map("commit_id")
  mutations Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@unique([sheetId, rev])
  @@index([sheetId, rev])
  @@map("sheet_changesets")
}

model SavedView {
  id        String   @id @default(uuid()) @db.Uuid
  sheetId   String   @map("sheet_id") @db.Uuid
  name      String
  query     Json     @default("{}")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@unique([sheetId, name])
  @@index([sheetId])
  @@map("saved_views")
}

model Field {
  id        String   @id @default(uuid()) @db.Uuid
  sheetId   String   @map("sheet_id") @db.Uuid
  name      String
  type      String
  options   Json?
  order     Int      @default(0)
  required  Boolean  @default(false)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId])
  @@map("fields")
}

// Table name is "records"; the Prisma model avoids shadowing TS's Record utility.
model RecordRow {
  id          String   @id @default(uuid(7)) @db.Uuid
  sheetId     String   @map("sheet_id") @db.Uuid
  cells       Json     @default("{}")
  version     Int      @default(1)
  // Indexable side column for claim hot paths (never the only representation).
  claimStatus String?  @map("claim_status")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId, id])
  @@index([sheetId, claimStatus])
  @@map("records")
}

model Comment {
  id        String   @id @default(uuid(7)) @db.Uuid
  sheetId   String   @map("sheet_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sheet  Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([sheetId, createdAt])
  @@map("comments")
}

model Form {
  id              String   @id @default(uuid()) @db.Uuid
  baseId          String   @map("base_id") @db.Uuid
  sheetId         String   @map("sheet_id") @db.Uuid
  name            String
  coverUrl        String?  @map("cover_url")
  fields          Json     @default("[]")
  share           Json     @default("{}")
  shareToken      String   @unique @map("share_token")
  successTemplate String   @default("") @map("success_template")
  rejectDuplicatePhone Boolean @default(true) @map("reject_duplicate_phone")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  base        Base             @relation(fields: [baseId], references: [id], onDelete: Cascade)
  sheet       Sheet            @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@index([baseId])
  @@index([sheetId])
  @@map("forms")
}

model FormSubmission {
  id        String   @id @default(uuid(7)) @db.Uuid
  formId    String   @map("form_id") @db.Uuid
  recordId  String?  @map("record_id") @db.Uuid
  status    String   @default("completed")
  cells     Json     @default("{}")
  resultHtml String? @map("result_html")
  stepOutputs Json  @default("{}") @map("step_outputs")
  error     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@map("form_submissions")
}

model Automation {
  id           String   @id @default(uuid()) @db.Uuid
  baseId       String   @map("base_id") @db.Uuid
  name         String
  enabled      Boolean  @default(true)
  trigger      Json
  steps        Json     @default("[]")
  onFindEmpty  String   @default("continue") @map("on_find_empty")
  monthlyQuota Int?     @map("monthly_quota")
  lastRunAt    DateTime? @map("last_run_at") @db.Timestamptz(6)
  nextRunAt    DateTime? @map("next_run_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  base Base            @relation(fields: [baseId], references: [id], onDelete: Cascade)
  runs AutomationRun[]

  @@index([baseId])
  @@map("automations")
}

model AutomationRun {
  id              String    @id @default(uuid(7)) @db.Uuid
  automationId    String    @map("automation_id") @db.Uuid
  status          String    @default("running")
  idempotencyKey  String?   @map("idempotency_key")
  triggerRecordId String?   @map("trigger_record_id") @db.Uuid
  outputs         Json      @default("{}")
  error           String?
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs      Int?      @map("duration_ms")
  /** 延迟步骤：waiting 状态下到期后续跑 */
  resumeAt        DateTime? @map("resume_at") @db.Timestamptz(6)
  resumeContext   Json?     @map("resume_context")
  parentRunId     String?   @map("parent_run_id") @db.Uuid

  automation Automation        @relation(fields: [automationId], references: [id], onDelete: Cascade)
  steps      AutomationRunStep[]

  @@unique([automationId, idempotencyKey])
  @@index([automationId, startedAt])
  @@index([status, resumeAt])
  @@map("automation_runs")
}

model AutomationRunStep {
  id         String   @id @default(uuid(7)) @db.Uuid
  runId      String   @map("run_id") @db.Uuid
  stepIndex  Int      @map("step_index")
  type       String
  status     String
  output     Json     @default("{}")
  error      String?
  durationMs Int?     @map("duration_ms")

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, stepIndex])
  @@map("automation_run_steps")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model GroupChat {
  id        String   @id @default(uuid(7)) @db.Uuid
  baseId    String   @map("base_id") @db.Uuid
  name      String
  memberIds Json     @default("[]") @map("member_ids")
  wecomChatId String? @unique @map("wecom_chat_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([baseId])
  @@map("group_chats")
}

model ContentPermission {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  objectType  String   @map("object_type")
  objectId    String   @map("object_id") @db.Uuid
  /// everyone | member
  subjectType String   @map("subject_type") @default("everyone")
  /// empty string for the everyone row; user id for member rows
  subjectId   String   @map("subject_id") @default("")
  /// full | edit | view | none
  level       String
  recordRule  Json?    @map("record_rule")
  fieldRule   Json?    @map("field_rule")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([objectType, objectId, subjectType, subjectId])
  @@index([workspaceId, objectType])
  @@map("content_permissions")
}

model Dashboard {
  id        String   @id @default(uuid()) @db.Uuid
  baseId    String   @map("base_id") @db.Uuid
  name      String
  /// dashboard | report
  kind      String   @default("dashboard")
  layout    Json     @default("[]")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  base      Base             @relation(fields: [baseId], references: [id], onDelete: Cascade)
  widgets   DashboardWidget[]
  schedules DashboardSchedule[]
  aiSession DashboardAiSession?

  @@index([baseId])
  @@map("dashboards")
}

/// 仪表盘 AI Agent 会话（一仪表盘一会话）
model DashboardAiSession {
  id          String   @id @default(uuid()) @db.Uuid
  dashboardId String   @unique @map("dashboard_id") @db.Uuid
  /// idle | thinking | failed
  status      String   @default("idle")
  messages    Json     @default("[]")
  error       String?  @db.Text
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@map("dashboard_ai_sessions")
}

/// AI 分析报告：对话 + Markdown 报告（与仪表盘分离）
model AnalysisReport {
  id             String   @id @default(uuid()) @db.Uuid
  baseId         String   @map("base_id") @db.Uuid
  name           String
  /// draft | asking | exploring | generating | ready | failed
  status         String   @default("draft")
  messages       Json     @default("[]")
  steps          Json     @default("[]")
  sheetIds       Json     @default("[]") @map("sheet_ids")
  reportMarkdown String?  @map("report_markdown") @db.Text
  error          String?  @db.Text
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  base Base @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@index([baseId])
  @@map("analysis_reports")
}

model DashboardWidget {
  id          String   @id @default(uuid()) @db.Uuid
  dashboardId String   @map("dashboard_id") @db.Uuid
  /// bar | horizontalBar | line | pie | combo | wordcloud | metric | table | text
  type        String
  title       String
  sheetId     String?  @map("sheet_id") @db.Uuid
  /// { dimensionFieldId, metricFieldId, aggregation, sortBy, sortOrder, stackMode, … }
  config      Json     @default("{}")
  layout      Json     @default("{}")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@map("dashboard_widgets")
}

model DashboardSchedule {
  id          String    @id @default(uuid()) @db.Uuid
  dashboardId String    @map("dashboard_id") @db.Uuid
  cron        String
  /// notification | group-chat | wecom
  channel     String    @default("notification")
  enabled     Boolean   @default(true)
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz(6)
  nextRunAt   DateTime? @map("next_run_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  dashboard Dashboard            @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  runs      DashboardScheduleRun[]

  @@index([dashboardId])
  @@map("dashboard_schedules")
}

model DashboardScheduleRun {
  id         String   @id @default(uuid()) @db.Uuid
  scheduleId String   @map("schedule_id") @db.Uuid
  status     String
  message    String   @default("")
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  schedule DashboardSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, createdAt])
  @@map("dashboard_schedule_runs")
}

model CrossWorkspaceShare {
  id                String   @id @default(uuid()) @db.Uuid
  sourceWorkspaceId String   @map("source_workspace_id") @db.Uuid
  targetWorkspaceId String   @map("target_workspace_id") @db.Uuid
  /// base | sheet
  objectType        String   @map("object_type")
  objectId          String   @map("object_id") @db.Uuid
  /// view | edit
  role              String
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sourceWorkspace Workspace @relation("ShareSourceWorkspace", fields: [sourceWorkspaceId], references: [id], onDelete: Cascade)
  targetWorkspace Workspace @relation("ShareTargetWorkspace", fields: [targetWorkspaceId], references: [id], onDelete: Cascade)

  @@unique([objectType, objectId, targetWorkspaceId])
  @@index([targetWorkspaceId])
  @@index([sourceWorkspaceId])
  @@map("cross_workspace_shares")
}

model PublicView {
  id           String    @id @default(uuid()) @db.Uuid
  sheetId      String    @map("sheet_id") @db.Uuid
  token        String    @unique
  name         String
  passwordHash String?   @map("password_hash")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  enabled      Boolean   @default(true)
  /** 公开内容范围：工作表 id；空数组 + 其它范围皆空时回落 host sheetId */
  sheetIds           Json @default("[]") @map("sheet_ids")
  /** 表单收集结果（关联 Form 的 sheet） */
  formSheetIds       Json @default("[]") @map("form_sheet_ids")
  dashboardIds       Json @default("[]") @map("dashboard_ids")
  analysisReportIds  Json @default("[]") @map("analysis_report_ids")
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId])
  @@map("public_views")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  prefix      String
  tokenHash   String    @unique @map("token_hash")
  scopes      Json      @default("[\"read\",\"write\"]")
  createdBy   String?   @map("created_by") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("api_keys")
}

model Webhook {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  url         String
  secret      String
  events      Json      @default("[\"record.created\",\"record.updated\",\"record.deleted\"]")
  active      Boolean   @default(true)
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  webhookId      String    @map("webhook_id") @db.Uuid
  event          String
  payload        Json
  status         String    @default("pending")
  attempts       Int       @default(0)
  responseStatus Int?      @map("response_status")
  error          String    @default("")
  nextRetryAt    DateTime? @map("next_retry_at") @db.Timestamptz(6)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  objectType  String   @map("object_type")
  objectId    String?  @map("object_id")
  metadata    Json     @default("{}")
  ip          String   @default("")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workspaceId, createdAt])
  @@index([action])
  @@index([objectType, objectId])
  @@map("audit_logs")
}

model QuotaPolicy {
  id                          String   @id @default(uuid()) @db.Uuid
  key                         String   @unique
  workspaceId                 String?  @unique @map("workspace_id") @db.Uuid
  maxSeats                    Int      @default(50) @map("max_seats")
  maxStorageBytes             BigInt   @default(10737418240) @map("max_storage_bytes")
  maxAutomationRunsPerMonth   Int      @default(10000) @map("max_automation_runs_per_month")
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("quota_policies")
}

model StorageObject {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  key         String
  sizeBytes   BigInt   @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workspaceId])
  @@map("storage_objects")
}

model DataSync {
  id          String    @id @default(uuid()) @db.Uuid
  sheetId     String    @map("sheet_id") @db.Uuid
  name        String
  sourceType  String    @map("source_type")
  config      Json      @default("{}")
  mapping     Json      @default("{}")
  matchFieldId String?  @map("match_field_id") @db.Uuid
  mode        String    @default("upsert")
  cron        String?
  enabled     Boolean   @default(true)
  nextRunAt   DateTime? @map("next_run_at") @db.Timestamptz(6)
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sheet Sheet          @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  runs  DataSyncRun[]

  @@index([sheetId])
  @@index([enabled, nextRunAt])
  @@map("data_syncs")
}

model DataSyncRun {
  id           String    @id @default(uuid()) @db.Uuid
  syncId       String    @map("sync_id") @db.Uuid
  status       String    @default("running")
  trigger      String    @default("manual")
  rowsRead     Int       @default(0) @map("rows_read")
  rowsWritten  Int       @default(0) @map("rows_written")
  error        String    @default("")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)

  sync DataSync @relation(fields: [syncId], references: [id], onDelete: Cascade)

  @@index([syncId, startedAt])
  @@map("data_sync_runs")
}

model DataSyncFile {
  id        String   @id @default(uuid()) @db.Uuid
  sheetId   String   @map("sheet_id") @db.Uuid
  filename  String
  mimetype  String   @default("")
  size      Int
  content   Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sheetId])
  @@map("data_sync_files")
}

/** MessageCenter / commitchanges 幂等：clientOpId 去重（对齐 ERR_COMMIT_DUPLICATED） */
model CommitOp {
  id         String   @id @default(uuid(7)) @db.Uuid
  clientOpId String   @unique @map("client_op_id")
  sheetId    String?  @map("sheet_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  opType     String   @map("op_type")
  result     Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sheetId, createdAt])
  @@map("commit_ops")
}

/** 公开表单提交幂等（领码防双花） */
model FormSubmitIdempotency {
  id               String   @id @default(uuid(7)) @db.Uuid
  idempotencyKey   String   @unique @map("idempotency_key")
  formId           String   @map("form_id") @db.Uuid
  submissionId     String?  @map("submission_id") @db.Uuid
  result           Json
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([formId])
  @@map("form_submit_idempotency")
}
