# ---- Application ----
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# 前端公开测试顶栏（Vite 构建期注入）。1=显示「测试版 / 数据将清空」；正式环境构建改为 0
VITE_PREVIEW_BANNER=1

# ---- PostgreSQL (through PgBouncer, transaction pooling) ----
POSTGRES_USER=smarttable
POSTGRES_PASSWORD=smarttable_dev_password
POSTGRES_DB=smarttable
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432

# Prisma / app runtime: pooled connection (transaction mode)
DATABASE_URL=postgresql://smarttable:smarttable_dev_password@127.0.0.1:6432/smarttable?pgbouncer=true&connection_limit=20
# Migrations and DDL: direct connection, never through PgBouncer
DIRECT_DATABASE_URL=postgresql://smarttable:smarttable_dev_password@127.0.0.1:5432/smarttable

# ---- Redis / BullMQ ----
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380
# Live Bus / Collab 跨副本扇出（设为 0 则本机 memory-only）
# LIVE_REDIS=1
# COLLAB_REDIS=1
# 表提交 Actor：memory（默认进程内串行）| bullmq（外置队列，杀副本可重试）
# COLLAB_SHEET_ACTOR=memory
# 千人同表背压（S5）：每表连接上限（0=不限）、光标最小间隔 ms、presence 防抖 ms
# COLLAB_MAX_SHEET_CONNECTIONS=1000
# COLLAB_CURSOR_MIN_INTERVAL_MS=80
# COLLAB_PRESENCE_DEBOUNCE_MS=250

# ---- Object storage ----
# S3_DRIVER=filesystem: local directory emulating S3 (dev default, no MinIO needed)
# S3_DRIVER=minio:      real MinIO via `docker compose --profile object-storage up -d`
S3_DRIVER=filesystem
S3_BUCKET=smart-table
# Used when S3_DRIVER=filesystem
S3_LOCAL_DIR=.data/s3

# ---- MinIO (S3 compatible; object-storage profile) ----
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=smarttable
MINIO_ROOT_PASSWORD=smarttable_dev_password
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=smarttable
S3_SECRET_KEY=smarttable_dev_password
S3_FORCE_PATH_STYLE=true
# Public base URL for uploaded objects (browser-facing)
S3_PUBLIC_URL=http://127.0.0.1:3000/files
# Override when using a locally loaded image (docker load)
MINIO_IMAGE=minio/minio:RELEASE.2024-10-13T13-34-11Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2024-10-08T09-37-26Z

# ---- Auth ----
# Local/dev placeholder OK. Production / STRICT_ENV=1: random >=32 chars, must NOT contain "dev-only".
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRES_IN=48h
# Optional: force JWT fail-closed even outside NODE_ENV=production
# STRICT_ENV=1
# Prometheus scrape token (required when NODE_ENV=production; send as Bearer / x-metrics-token)
# METRICS_TOKEN=

# ---- Form submit mode: sync | queue ----
SUBMIT_MODE=sync
# ---- Automation execution: inline | bullmq ----
AUTOMATION_QUEUE=inline
# Background cron runner for schedule automations (default on, 15s poll)
AUTOMATION_SCHEDULER_ENABLED=true

# ---- Public form sharing ----
# Base URL used to build share/QR links and success-page redirects
PUBLIC_FORM_BASE_URL=http://localhost:5173
# Max public submissions per share token + IP within 60 seconds
PUBLIC_SUBMIT_RATE_LIMIT=30
# Max concurrent form submissions admitted per API replica (others queue)
SUBMIT_MAX_CONCURRENCY=64

# ---- AI field fill (optional HTTP provider) ----
# When unset, AI fields use local {{字段名}} template / source-field fallback.
# AI_FIELD_URL=http://127.0.0.1:8090/v1/ai-field
# AI_FIELD_MODEL=local

# ---- AI analysis report (optional OpenAI-compatible chat) ----
# When unset, analysis reports use local sheet-digest Markdown (no external call).
# ANALYSIS_LLM_BASE_URL=https://api.openai.com/v1
# ANALYSIS_LLM_API_KEY=
# ANALYSIS_LLM_MODEL=gpt-4o-mini

# ---- Analytics port (dashboard charts) ----
# postgres (default) | clickhouse
ANALYTICS_ADAPTER=postgres
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=smart_table
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ---- WeCom (disabled in product; login uses local accounts only) ----
# WECOM_ENABLED=false

# ---- Quotas / installation admin ----
# 系统管理员账号（逗号分隔，小写）；留空则取最早注册用户。可看反馈后台 /admin/feedback、改全局配额
INSTALL_ADMIN_ACCOUNTS=
QUOTA_MAX_SEATS=50
QUOTA_MAX_STORAGE_BYTES=10737418240
# 自动化运行次数不限额（该变量仅作历史兼容，运行时不再拦截）
# QUOTA_MAX_AUTOMATION_RUNS_PER_MONTH=0

# ---- OpenTelemetry (OTLP/HTTP) ----
OTEL_ENABLED=false
OTEL_SERVICE_NAME=smart-table-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
