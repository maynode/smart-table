# ---- Application ----
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# ---- PostgreSQL (through PgBouncer, transaction pooling) ----
POSTGRES_USER=smarttable
POSTGRES_PASSWORD=smarttable_dev_password
POSTGRES_DB=smarttable
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432

# Prisma / app runtime: pooled connection (transaction mode)
DATABASE_URL=postgresql://smarttable:smarttable_dev_password@127.0.0.1:6432/smarttable?pgbouncer=true&connection_limit=10
# Migrations and DDL: direct connection, never through PgBouncer
DIRECT_DATABASE_URL=postgresql://smarttable:smarttable_dev_password@127.0.0.1:5432/smarttable

# ---- Redis / BullMQ ----
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380

# ---- Object storage ----
# S3_DRIVER=filesystem: local directory emulating S3 (dev default, no MinIO needed)
# S3_DRIVER=minio:      real MinIO via `docker compose --profile object-storage up -d`
S3_DRIVER=filesystem
S3_BUCKET=smart-table
# Used when S3_DRIVER=filesystem
S3_LOCAL_DIR=.data/s3

# ---- MinIO (S3 compatible; object-storage profile) ----
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=smarttable
MINIO_ROOT_PASSWORD=smarttable_dev_password
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=smarttable
S3_SECRET_KEY=smarttable_dev_password
S3_FORCE_PATH_STYLE=true
# Public base URL for uploaded objects (browser-facing)
S3_PUBLIC_URL=http://127.0.0.1:3000/files
# Override when using a locally loaded image (docker load)
MINIO_IMAGE=minio/minio:RELEASE.2024-10-13T13-34-11Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2024-10-08T09-37-26Z

# ---- Auth ----
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRES_IN=7d

# ---- Form submit mode: sync | queue ----
SUBMIT_MODE=sync
# ---- Automation execution: inline | bullmq ----
AUTOMATION_QUEUE=inline

# ---- Public form sharing ----
# Base URL used to build share/QR links and success-page redirects
PUBLIC_FORM_BASE_URL=http://localhost:5173
# Max public submissions per share token + IP within 60 seconds
PUBLIC_SUBMIT_RATE_LIMIT=30
# Max concurrent form submissions admitted per API replica (others queue)
SUBMIT_MAX_CONCURRENCY=64

# ---- Analytics port (dashboard/report) ----
# postgres (default) | clickhouse
ANALYTICS_ADAPTER=postgres
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=smart_table
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ---- WeCom OAuth + application messages ----
# Enable only after filling corp id/secret/agent id. Set WECOM_MOCK_IDP_URL and
# WECOM_MOCK_NOTIFY_URL for local integration tests instead of real WeCom.
WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_AGENT_ID=
WECOM_REDIRECT_URI=http://localhost:5173/login
WECOM_MOCK_IDP_URL=
WECOM_MOCK_NOTIFY_URL=

# ---- Quotas / installation admin ----
INSTALL_ADMIN_EMAILS=
QUOTA_MAX_SEATS=50
QUOTA_MAX_STORAGE_BYTES=10737418240
QUOTA_MAX_AUTOMATION_RUNS_PER_MONTH=10000

# ---- OpenTelemetry (OTLP/HTTP) ----
OTEL_ENABLED=false
OTEL_SERVICE_NAME=smart-table-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
